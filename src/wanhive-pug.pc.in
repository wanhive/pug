prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
pkgincludedir=@includedir@/wanhive

Name: @PACKAGE@
Description: Wanhive Pug physical computing library
URL: @PACKAGE_URL@
Version: @VERSION@
Requires.private: wanhive >= @WHUB_VERSION@ libcamera >= @LIBCAM_VERSION@
Cflags: -I${includedir} @WHUB_CFLAGS@ @LIBCAM_CFLAGS@
Libs: -L${libdir} -lwanhive-pug
Libs.private: -lm -ljpeg -li2c -lgps
