prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@
pkgincludedir=@includedir@/wanhive

Name: @PACKAGE@
Description: Physical computing library
URL: @PACKAGE_URL@
Version: @VERSION@
Requires.private: wanhive >= 15.0.0 libcamera >= 0.2.0
Cflags: -I${includedir} @WHUB_CFLAGS@ @LIBCAM_CFLAGS@
Libs: -L${libdir} -lwanhivepug
Libs.private: -lm -ljpeg -li2c -lgps
